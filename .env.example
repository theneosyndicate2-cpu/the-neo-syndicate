# Public site URL (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.theneosyndicate.com

# Social links — placeholders are shown until these are set
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Market data. By default live prices come from free public feeds
# (Swissquote spot, Coinbase, ICE/COMEX session data) — no keys needed.
# Set MARKET_DATA_PROVIDER=demo to force demo data, or point
# MARKET_DATA_API_URL at your own licensed feed returning { quotes: RawQuote[] }.
# See src/services/marketData.ts.
MARKET_DATA_PROVIDER=
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=

# Optional webhook that receives investment applications and contact
# messages as JSON POST bodies (e.g. a CRM, Zapier, Make, n8n, Slack).
APPLICATIONS_WEBHOOK_URL=
