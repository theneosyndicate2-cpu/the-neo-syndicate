# Public site URL (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.theneosyndicate.com

# Social links — placeholders are shown until these are set
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Market data. By default live prices come from free public feeds
# (Swissquote spot, Coinbase, ICE/COMEX session data) — no keys needed.
# Set MARKET_DATA_PROVIDER=demo to force demo data, or point
# MARKET_DATA_API_URL at your own licensed feed returning { quotes: RawQuote[] }.
# See src/services/marketData.ts.
MARKET_DATA_PROVIDER=
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=

# Admin desk access: comma-separated emails whose accounts can open /admin.
# (Admins can also promote other members from the Members page.)
ADMIN_EMAILS=

# Database. Leave empty locally to use the embedded Postgres (PGlite) stored in .data/.
# In production set a hosted Postgres URL (Neon, Supabase, Railway, RDS…). Tables are created automatically.
DATABASE_URL=

# Email verification for applications.
# VERIFICATION_SECRET: 32+ random characters (signs verification tokens). Required in production.
# RESEND_API_KEY + EMAIL_FROM: sends real emails via https://resend.com (EMAIL_FROM must use a domain verified in Resend).
# EMAIL_DELIVERY=console: test mode — codes are logged and shown on screen. Never enable on the live site.
VERIFICATION_SECRET=
RESEND_API_KEY=
EMAIL_FROM="The Neo Syndicate <desk@theneosyndicate.com>"
EMAIL_DELIVERY=

# Optional webhook that receives investment applications and contact
# messages as JSON POST bodies (e.g. a CRM, Zapier, Make, n8n, Slack).
APPLICATIONS_WEBHOOK_URL=
